{
  "name": "teabranch-app",
  "version": "0.12.0",
  "private": true,
  "description": "Parallel branch development environment manager",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper && scripts/dev-bundle-name.sh"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.21",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "anser": "2.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.61.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "productName": "TeaBranch"
}
